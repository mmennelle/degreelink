# Grafana Environment Variables
# Copy this to .env.grafana and fill in your values
# NEVER commit .env.grafana to git!

# Grafana Admin Credentials
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# PostgreSQL Read-Only User for Grafana
GRAFANA_POSTGRES_USER=grafana_readonly
GRAFANA_POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD
GRAFANA_POSTGRES_HOST=localhost
GRAFANA_POSTGRES_PORT=5432
GRAFANA_POSTGRES_DATABASE=course_transfer

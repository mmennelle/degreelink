          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n  p.name AS \"Program\",\n  COUNT(pl.id) AS \"Plans\"\nFROM programs p\nLEFT JOIN plans pl ON pl.program_id = p.id\nGROUP BY p.id, p.name\nHAVING COUNT(pl.id) > 0\nORDER BY COUNT(pl.id) DESC\nLIMIT 10",
